// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Diagnostic {
  id              String   @id @default(cuid())
  unitId          String
  unitName        String
  buildingName    String
  generatedAt     DateTime @default(now())
  
  // Country and user tracking
  country         String   @default("FR")
  userId          String?
  userName        String?
  
  // Store full diagnostic data as JSON
  visitReports    Json     @default("[]")
  breakdowns      Json     @default("[]")
  maintenanceIssues Json   @default("[]")
  repairRequests  Json?
  analysis        Json?
  
  // Relations
  feedback        Feedback[]
  
  // Indexes for faster queries
  @@index([unitId])
  @@index([generatedAt])
  @@index([unitName])
  @@index([buildingName])
  @@index([country])
  @@index([userId])
  @@map("diagnostics")
}

model Feedback {
  id              String   @id @default(cuid())
  diagnosticId    String
  diagnostic      Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  
  // User who provided feedback
  userId          String
  userName        String
  
  // What section was rated
  section         String   // e.g., "executiveSummary", "technicalAnalysis", "timeline", etc.
  sectionLabel    String   // Human-readable label for display
  
  // Feedback content
  sentiment       String   // "positive" or "negative" (thumbs up/down)
  category        String?  // e.g., "inaccurate", "missing_info", "too_technical", "excellent", "clear"
  comment         String?  // Optional detailed comment
  
  createdAt       DateTime @default(now())
  
  // Indexes for faster queries
  @@index([diagnosticId])
  @@index([userId])
  @@index([createdAt])
  @@index([sentiment])
  @@map("feedback")
}
